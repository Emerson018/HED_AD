# ==============================================================================
# HED AD - Template de Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env no repositório!
# ==============================================================================

# ---- Django Core ----
# Gere uma nova SECRET_KEY com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- CORS ----
# Domínios do frontend que podem acessar a API (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Serviço de Email (Transacional) ----
# Provedor de e-mail (opções: emailjs, resend, sendgrid, brevo). Padrão: emailjs
EMAIL_PROVIDER=emailjs
# Chave de API do provedor de email (necessária para resend, sendgrid ou brevo)
EMAIL_API_KEY=
# Endereço de email remetente (deve ser verificado no provedor)
EMAIL_FROM_ADDRESS=
# URL do frontend (usada para links nos emails de redefinição de senha)
FRONTEND_URL=http://localhost:5173

# ---- Configuração do EmailJS ----
# ID do serviço configurado no painel do EmailJS
EMAILJS_SERVICE_ID=
# Chave pública (public key) da conta EmailJS
EMAILJS_USER_ID=
# ID do template para e-mails de credenciais de acesso
EMAILJS_TEMPLATE_CREDENTIALS_ID=
# ID do template para e-mails de redefinição de senha
EMAILJS_TEMPLATE_RESET_ID=

# ---- Banco de Dados (Supabase PostgreSQL) ----
# Preencha para usar PostgreSQL. Se vazio, usa SQLite local.
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
